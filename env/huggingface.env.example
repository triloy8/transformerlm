# Hugging Face Hub publishing.
# HF_TOKEN=hf_your_token

# Optional automatic checkpoint publishing during training.
# If CHECKPOINTING_HF_REPO_ID is set, rank 0 uploads the full run directory
# after each checkpoint save.
# CHECKPOINTING_HF_REPO_ID=your-user-or-org/your-model-repo
# CHECKPOINTING_HF_REPO_TYPE=model
# CHECKPOINTING_HF_REVISION=main
# CHECKPOINTING_HF_PATH_IN_REPO=
# CHECKPOINTING_HF_PRIVATE=false
# CHECKPOINTING_HF_STRICT=false
